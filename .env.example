# Runtime environment variables — set these in the host's Environment tab.
# Never commit real secrets. See README.md / *_DEPLOY_GUIDE.md.

# PORT is injected automatically by both hosts; the app falls back to 3000.
#   Abasthan: auto-injected, do NOT set it manually (abasthan.com/docs/deploy-nodejs)
#   Deplexo : controlled by `run.port: 3000` in deplexo.yaml
PORT=3000
NODE_ENV=production

# Deplexo: persistent named volume mounted at /data by default.
# Abasthan: no persistent volume is documented. If you attach one, point
# DB_PATH at that mount; otherwise the app falls back to a local/temp file
# and the database is lost on every redeploy (use /api/backup/restore).
DB_PATH=/data/db.json
# DB_FALLBACK_PATHS=/mnt/data/db.json,/tmp/db.json

# Abasthan (clean build env):
#   Build Command: npm ci && npm run build
#   Start Command: npm start
# `prestart` installs dependencies ONLY when they are missing.
#
# Belmo / Coolify (Nixpacks) — DO NOT use the Abasthan build command here!
#   Build Command: empty or `npm run build`  (Nixpacks already runs npm ci)
#   Start Command: empty / npm start
#   Ports Exposes: 3000, health check: /health
# Or simply switch Build Pack to "Dockerfile" and leave all commands empty.
# See BELMO_DEPLOY_GUIDE.md and nixpacks.toml.

# Optional: disable the 4-minute self-ping on always-on hosts.
KEEPALIVE_ENABLED=0
# KEEPALIVE_URL=https://your-app.example.com

# ---------------------------------------------------------------------------
# 128 MB RAM plans — RECOMMENDED (see LOW_MEMORY_128MB_GUIDE.md)
# ---------------------------------------------------------------------------
# Set these on a 128 MiB host; leave them unset on larger hosts. When the
# cgroup limit is available it is detected automatically. RSS fallback cannot
# account for other processes or kernel buffers, so it is less accurate.
# MEMORY_LIMIT_MB=128
# NODE_OPTIONS="--max-old-space-size=48 --max-semi-space-size=1"
# Optional on glibc-based images; it has no effect on Alpine's musl allocator.
# MALLOC_ARENA_MAX=1

# Optional guard settings. Low-memory defaults: 0.60 / 0.72 / 0.53.
# MEMORY_GUARD=1
# MEMORY_GUARD_SOFT=0.60
# MEMORY_GUARD_HARD=0.72
# MEMORY_GUARD_RECOVER=0.53
# MEMORY_GUARD_INTERVAL_MS=200
# MEMORY_GUARD_WAIT_MS=3000
# MEMORY_GUARD_ADMISSION_MB=10
# MEMORY_GUARD_BURST_WINDOW_MS=300

# Low-memory mode already caps per-connection buffers and payloads.
# SMART_BOOSTER=0
# MAX_WS_PAYLOAD=1048576
# MAX_XHTTP_POST_SIZE=1048576
# MAX_XHTTP_BUFFERED_POSTS=8
# MAX_XHTTP_DOWNLINK_BUFFER=262144
# MAX_XHTTP_QUEUED_BYTES=4194304
# WS_BACKPRESSURE_LIMIT=262144
# MAX_MUX_SESSIONS=32
