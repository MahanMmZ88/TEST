# Runtime environment variables — set these in the host's Environment tab.
# Never commit real secrets. See README.md / *_DEPLOY_GUIDE.md.

# PORT is injected automatically by both hosts; the app falls back to 3000.
#   Abasthan: auto-injected, do NOT set it manually (abasthan.com/docs/deploy-nodejs)
#   Deplexo : controlled by `run.port: 3000` in deplexo.yaml
PORT=3000
NODE_ENV=production

# Deplexo: persistent named volume mounted at /data by default.
# Abasthan: no persistent volume is documented. If you attach one, point
# DB_PATH at that mount; otherwise the app falls back to a local/temp file
# and the database is lost on every redeploy (use /api/backup/restore).
DB_PATH=/data/db.json
# DB_FALLBACK_PATHS=/mnt/data/db.json,/tmp/db.json

# Abasthan build command (dashboard):
#   npm ci && npm run build
# Start command: npm start   (or npm run start)
# `prestart` installs dependencies ONLY when they are missing.

# Optional: disable the 4-minute self-ping on always-on hosts.
KEEPALIVE_ENABLED=0
# KEEPALIVE_URL=https://your-app.example.com

# Optional low-memory tuning for a 128 MB plan.
# MAX_XHTTP_BUFFERED_POSTS=8
# MAX_XHTTP_DOWNLINK_BUFFER=1048576
# MAX_XHTTP_POST_SIZE=1048576
