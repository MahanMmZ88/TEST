# Copy these names into Deplexo > App > Environment (do NOT commit real secrets).
# PORT is controlled by `run.port` in deplexo.yaml and injected automatically.
PORT=3000
NODE_ENV=production

# Deplexo persistent data volume (Dashboard > Storage / Mounts, default /data).
# If you change the mount path there, change DB_PATH to match.
DB_PATH=/data/db.json

# Optional extra writable locations, comma separated, tried in order.
# DB_FALLBACK_PATHS=/mnt/data/db.json,/tmp/db.json

# Deplexo free tier is always-on: self-ping is not required. Set to 0 to disable.
KEEPALIVE_ENABLED=0
# KEEPALIVE_URL=https://your-app.de.deplexo.com

# Optional low-memory tuning for the 128 MB free plan.
# MAX_XHTTP_BUFFERED_POSTS=8
# MAX_XHTTP_DOWNLINK_BUFFER=1048576
# MAX_XHTTP_POST_SIZE=1048576
