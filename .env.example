# Runtime environment variables — set these in the host's Environment tab.
# Never commit real secrets. See README.md / *_DEPLOY_GUIDE.md.

# PORT is injected automatically by both hosts; the app falls back to 3000.
#   Abasthan: auto-injected, do NOT set it manually (abasthan.com/docs/deploy-nodejs)
#   Deplexo : controlled by `run.port: 3000` in deplexo.yaml
PORT=3000
NODE_ENV=production

# Deplexo: persistent named volume mounted at /data by default.
# Abasthan: no persistent volume is documented. If you attach one, point
# DB_PATH at that mount; otherwise the app falls back to a local/temp file
# and the database is lost on every redeploy (use /api/backup/restore).
DB_PATH=/data/db.json
# DB_FALLBACK_PATHS=/mnt/data/db.json,/tmp/db.json

# Abasthan (clean build env):
#   Build Command: npm ci && npm run build
#   Start Command: npm start
# `prestart` installs dependencies ONLY when they are missing.
#
# Belmo / Coolify (Nixpacks) — DO NOT use the Abasthan build command here!
#   Build Command: empty or `npm run build`  (Nixpacks already runs npm ci)
#   Start Command: empty / npm start
#   Ports Exposes: 3000, health check: /health
# Or simply switch Build Pack to "Dockerfile" and leave all commands empty.
# See BELMO_DEPLOY_GUIDE.md and nixpacks.toml.

# Optional self-ping: the application default is enabled every 4 minutes;
# this example disables it. Disabling can let a service sleep on some plans.
# The authenticated dashboard can pause/resume it temporarily without restart.
KEEPALIVE_ENABLED=0
# KEEPALIVE_URL=https://your-app.example.com
# If enabled without KEEPALIVE_URL, a request Host is auto-detected by default.
# To avoid accepting an untrusted Host as the target, disable auto-detection
# and set KEEPALIVE_URL explicitly. With neither target, no self-ping is sent.
# KEEPALIVE_AUTO_DETECT=0
# KEEPALIVE_INTERVAL_MS=240000
# Optional self-ping header only; it does not change VPN client traffic.
# A host/WAF may require the legacy value, so test before changing it.
# KEEPALIVE_USER_AGENT=health-check/1.0

# Optional: keep anonymous health responses minimal; authenticated admins still
# get detailed /api/health. This can change existing public monitoring output.
# PUBLIC_HEALTH_MINIMAL=1
# Per-connection destinations, IPs, and user names are omitted from ordinary
# logs by default. Opt in only for troubleshooting; these details are sensitive.
# LOG_SENSITIVE_DETAILS=1
# DEBUG_ACTIVE_CLIENTS=1  # Also outputs sensitive activity data when enabled.
# These options do not hide the application or traffic from the hosting provider.

# ---------------------------------------------------------------------------
# 128 MB RAM plans — RECOMMENDED (see LOW_MEMORY_128MB_GUIDE.md)
# ---------------------------------------------------------------------------
# Set these on a 128 MiB host; leave them unset on larger hosts. When the
# cgroup limit is available it is detected automatically. RSS fallback cannot
# account for other processes or kernel buffers, so it is less accurate.
# MEMORY_LIMIT_MB=128
# NODE_OPTIONS="--max-old-space-size=48 --max-semi-space-size=1"
# Optional on glibc-based images; it has no effect on Alpine's musl allocator.
# MALLOC_ARENA_MAX=1

# Optional guard settings. Low-memory defaults: 0.60 / 0.72 / 0.53.
# MEMORY_GUARD=1
# MEMORY_GUARD_SOFT=0.60
# MEMORY_GUARD_HARD=0.72
# MEMORY_GUARD_RECOVER=0.53
# MEMORY_GUARD_INTERVAL_MS=200
# MEMORY_GUARD_WAIT_MS=3000
# MEMORY_GUARD_ADMISSION_MB=10
# MEMORY_GUARD_BURST_WINDOW_MS=300

# Low-memory mode already caps per-connection buffers and payloads.
# SMART_BOOSTER=0
# MAX_WS_PAYLOAD=1048576
# MAX_XHTTP_POST_SIZE=1048576
# MAX_XHTTP_BUFFERED_POSTS=32
# MAX_XHTTP_DOWNLINK_BUFFER=262144
# MAX_XHTTP_QUEUED_BYTES=4194304
# MAX_XHTTP_QUEUED_PACKETS=256
# WS_BACKPRESSURE_LIMIT=262144
# MAX_MUX_SESSIONS=32

# Optional raw TCP + REALITY. OFF by default; see REALITY_OPTIONAL_GUIDE.md.
# Not invisible to the host. Requires Linux/amd64, the pinned verified Xray
# binary, cgroup memory guard, >=256 MiB, a raw TCP port and VERIFIED original
# client source IPs. A TCP proxy may destroy source-IP based device limits.
# REALITY_ENABLED=1
# REALITY_PORT=8443
# REALITY_PUBLIC_HOST=your-tcp-host.example
# REALITY_PUBLIC_PORT=443
# REALITY_SNI=authorized-cover.example
# REALITY_PRIVATE_KEY=REPLACE_WITH_YOUR_PRIVATE_X25519_KEY
# REALITY_SHORT_ID=REPLACE_WITH_16_RANDOM_HEX_DIGITS
# REALITY_ACK_DIRECT_SOURCE_IP=1
# XRAY_BIN=/usr/local/bin/xray
# REALITY_TARGET_PORT=443
# REALITY_MAX_CONNECTIONS=256
# REALITY_ALLOW_PRIVATE_SOURCE=1  # Lab/direct private LAN only; see guide.
# REALITY_ALLOW_LOCAL_TARGET=1    # Unsafe outside an isolated test.
